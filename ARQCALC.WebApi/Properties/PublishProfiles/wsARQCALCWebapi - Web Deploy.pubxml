<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://wsarqcalcwebapi.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>wsarqcalcwebapi.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>wsARQCALCWebapi</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>False</EnableMSDeployBackup>
    <UserName>$wsARQCALCWebapi</UserName>
    <_SavePWD>True</_SavePWD>
    <_DestinationType>AzureWebSite</_DestinationType>
    <PublishDatabaseSettings>
      <Objects>
        <ObjectGroup Name="ARQCALCConnectionString" Order="1" Enabled="False">
          <Destination Path="Data Source=tcp:arqcalcbbddsrv.database.windows.net,1433;Initial Catalog=ARQCALC;Persist Security Info=False;User ID=usradminbbdd;Password=Geminis1977+;Connect Timeout=30;Encrypt=True;TrustServerCertificate=False" Name="Data Source=tcp:arqcalcbbddsrv.database.windows.net,1433;Initial Catalog=ARQCALC;Persist Security Info=False;User ID=usradminbbdd;Password=Geminis1977+;MultipleActiveResultSets=False;Connect Timeout=30;Encrypt=True;TrustServerCertificate=False" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=arqcalcbbddsrv.database.windows.net;Initial Catalog=ARQCALC;Integrated Security=False;User ID=usradminbbdd;Password=Geminis1977+;Connect Timeout=60;Encrypt=False;TrustServerCertificate=True;ApplicationIntent=ReadWrite;MultiSubnetFailover=False" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\ARQCALCConnectionString_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Data Source=arqcalcbbddsrv.database.windows.net;Initial Catalog=ARQCALC;Integrated Security=False;User ID=usradminbbdd;Password=Geminis1977+;Connect Timeout=60;Encrypt=False;TrustServerCertificate=True;ApplicationIntent=ReadWrite;MultiSubnetFailover=False" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
    <ADUsesOwinOrOpenIdConnect>False</ADUsesOwinOrOpenIdConnect>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)ARQCALCConnectionString-Web.config Connection String">
      <ParameterValue>Data Source=tcp:arqcalcbbddsrv.database.windows.net,1433;Initial Catalog=ARQCALC;Persist Security Info=False;User ID=usradminbbdd;Password=Geminis1977+;MultipleActiveResultSets=False;Connect Timeout=30;Encrypt=True;TrustServerCertificate=False</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>